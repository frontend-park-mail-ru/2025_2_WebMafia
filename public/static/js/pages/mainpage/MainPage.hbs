<div class="section" id="section">
  {{> header}}

  <div class="layout">
    {{> sidebar}}
    <div class="page" id="scrollContent">
      {{#if isAuthenticated}}
      <div class="now-playing-container">
        <button class="current-card-btn prev"></button>
        <div class="card-slider">
          <div class="now-playing-container-card">
            <img src="" alt="" />
          </div>
          <div class="now-playing-container-card">
            <img src="" alt="" />
          </div>
          <div class="now-playing-container-card">
            <img src="" alt="" />
          </div>
        </div>
        <button class="current-card-btn next"></button>
      </div>
      {{/if}}

      <!-- Артисты -->
      <div class="title">
        <div class="title-name">Артисты</div>
      </div>
      <div class="slider">
        <p><i class="slide-btn left"></i></p>
        <div class="cards" id="slidebar">
          {{#each artists}}
          <div class="card">
            <a href="/artist/{{ id }}">
              <img src="{{ image }}" alt="{{ name }}" />
              <p class="card-name">{{ name }}</p>
              <p class="card-sub">{{ listeners }}</p>
            </a>
            <!--<button class="play-button play-button-placement" data-artist-id="{{ artist_id }}"></button>-->
          </div>
          {{/each}}
        </div>
        <p><i class="slide-btn right"></i></p>
      </div>

      <!-- Альбомы -->
      <div class="title">
        <div class="title-name">Альбомы</div>
      </div>
      <div class="slider">
        <i class="slide-btn left"></i>
        <div class="cards" id="slidebar">
          {{#each albums}}
          <div class="card">
            <a href="/album/{{ id }}">
              <img src="{{ image }}" alt="{{ name }}" />
              <p class="card-name">{{ name }}</p>
              <p class="card-sub card-sub-limiter">
                {{ type }}
                <span class="dot"></span>
                <span class="text">{{ artist }}</span>
              </p>
            </a>
            <!--<button class="play-button play-button-placement" data-album-id="{{ album_id }}"></button>-->
          </div>
          {{/each}}
        </div>
        <i class="slide-btn right"></i>
      </div>

      <!-- Треки -->
      <div class="title">
        <div class="title-name">Треки</div>
      </div>
      <div class="slider">
        <p><i class="slide-btn left"></i></p>
        <div class="cards tracks" id="slidebar">
          {{#each tracks}}
          <div class="card-tracks">
            <a class="card-track-content" href="/album/{{ album_id }}">
              <img src="{{ image }}" alt="{{ name }}" />
              <div class="track-content">
                <p class="card-name-track">{{ name }}</p>
                {{#each artists}}
                <p class="card-sub-track">{{ name }}</p>
                {{/each}}
              </div>
            </a>

            <button class="play-button play-button-track" data-track-id="{{ id }}"></button>
          </div>
          {{/each}}
        </div>
        <p><i class="slide-btn right"></i></p>
      </div>
    </div>
  </div>
</div>
