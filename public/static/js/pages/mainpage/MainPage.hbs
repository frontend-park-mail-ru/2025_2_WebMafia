<div class="section" id="section">
  {{> header}}

  <div class="layout">
    <div class="purple-background-circle sidebar-purple-position"></div>
    {{> sidebar}}
    <div class="page" id="scrollContent">
      <div class="now-playing-container">
        <button class="current-card-btn prev"></button>

        <div class="now-playing-container-card-previous">
          <img src="/static/img/image11.jpg" alt="" />
        </div>
        <div class="now-playing-container-card-current">
          <img src="/static/img/image12.jpg" alt="" />
          <button class="current-card-btn play"></button>
          <p class="current-card-name">Queen</p>
        </div>
        <div class="now-playing-container-card-next">
          <img src="/static/img/image13.jpg" alt="" />
        </div>
        <button class="current-card-btn next"></button>
      </div>

      <!-- Артисты -->
      <div class="title">
        <div class="title-name">Артисты</div>
        <div class="show-all"><a href="/show_all/artists">Показать всё</a></div>
      </div>
      <div class="slider">
        <p><i class="slide-btn left"></i></p>
        <div class="cards" id="slidebar">
          {{#each artists}}
          <div class="card">
            <a href="/artist/{{ artist_id }}">
              <img src="{{ image }}" alt="{{ name }}" />
              <p class="card-name">{{ name }}</p>
            </a>
            <button class="play-button play-button-placement" data-artist-id="{{ artist_id }}"></button>
          </div>
          {{/each}}
        </div>
        <p><i class="slide-btn right"></i></p>
      </div>

      <!-- Альбомы -->
      <div class="title">
        <div class="title-name">Альбомы</div>
        <div class="show-all"><a href="/show_all/albums">Показать всё</a></div>
      </div>
      <div class="slider">
        <i class="slide-btn left"></i>
        <div class="cards" id="slidebar">
          {{#each albums}}
          <div class="card">
            <a href="/album/{{ album_id }}">
              <img src="{{ image }}" alt="{{ name }}" />
              <p class="card-name">{{ name }}</p>
              <p class="card-sub">{{ artist }}</p>
            </a>
            <button class="play-button play-button-placement" data-artist-id="{{ album_id }}"></button>
          </div>
          {{/each}}
        </div>
        <i class="slide-btn right"></i>
      </div>

      <!-- Треки -->
      <div class="title">
        <div class="title-name">Треки</div>
        <div class="show-all"><a href="/show_all/tracks">Показать всё</a></div>
      </div>
      <div class="slider">
        <p><i class="slide-btn left"></i></p>
        <div class="cards tracks" id="slidebar">
          {{#each tracks}}
          <div class="card-tracks">
            <a class="card-track-content" href="/album/{{ album.album_id }}">
              <img src="{{ image }}" alt="{{ name }}" />
              <div class="track-content">
                <p class="card-name-track">{{ name }}</p>
                {{#each artists}}
                <p class="card-sub-track">{{ name }}</p>
                {{/each}}
              </div>
            </a>

            <button class="play-button play-button-track" data-artist-id="{{ track_id }}"></button>
          </div>
          {{/each}}
        </div>
        <p><i class="slide-btn right"></i></p>
      </div>
    </div>
  </div>
  {{> player}}
</div>
