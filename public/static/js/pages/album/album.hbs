<div class="section" id="section">
  <div class="layout">
    {{> sidebar}}
    <div class="album-page" id="scrollContent">
      <div class="blue-background-circle profile-blue-position"></div>
      <div class="purple-background-circle profile-purple-position"></div>
      <div class="album-card">
        <div class="album-artist">
          <img class="album-artist-avatar" src="{{ artist.avatar_url }}"/>
          <a href="artist/{{ artist.id }}" class="album-artist-name">{{ artist.name }}</a>
        </div>
        <img class="album-cover" src="{{ cover }}" alt="" />
        <div class="album-card-title">{{ title }}</div>
        <div class="album-card-info">
          <div class="card-sub">{{ type }}<span class="dot"></span>{{ year }}</div>
          {{#if tracksNum}}
            <div class="card-sub">{{ tracksNum }} треков<span class="dot"></span>{{ totalDuration }} минут</div>
          {{/if}}
        </div>
      </div>
    </div>
    <div class="turquoise-oval"></div>
  </div>
</div>