<div class="section" id="section">
  <div class="layout">
    {{> sidebar}}
    <div class="album-page" id="scrollContent">
      <div class="blue-background-circle album-blue-position"></div>
      <div class="purple-background-circle album-purple-position"></div>
      <div class="album-card">
        <div class="album-artist">
          <img class="album-artist-avatar" src="{{ artist.avatar }}" alt="{{ artist.name }}" />
          <a href="artist/{{ artist.id }}" title="{{ artist.name }}" class="album-artist-name">{{ artist.name }}</a>
        </div>
        <img class="album-cover" src="{{ cover }}" alt="{{ title }}" />
        <div class="album-card-title">{{ title }}</div>
        <div class="album-card-info">
          <div class="card-sub">{{ type }}<span class="dot"></span>{{ year }}</div>
          <div class="card-sub">{{ tracksNum }}<span class="dot"></span>{{ totalDuration }}</div>
        </div>
        {{#if description}}
        <div class="card-sub album-description" id="getDescription">{{ description }}</div>
        {{/if}}
        <div class="album-buttons">
          <button class="like-btn black">{{> likeBtn }}</button>
          <button class="play-button play-button-album" data-album-id="{{ id }}" data-context="album-tracks"></button>
          <button class="control-btn black">{{> shuffle}}</button>
        </div>
      </div>
      <div class="tracks-card">
        <div class="album-table">
          {{#each tracks}}
          <div class="album-row">
            <div class="album-play-wrapper">
              <div class="album-track-number">{{numeration @index}}</div>
              <button
                class="play-album-track"
                data-track-id="{{ id }}"
                data-context="album-tracks"
                data-album-id="{{../id}}"
              >
                <span class="play-icon">{{> play }}</span>
                <span class="pause-icon">{{> pause }}</span>
              </button>
            </div>
            <div class="tracks-duration-wrapper">
              <div class="album-track-info">
                <div class="track-name">{{ name }}</div>
                <div class="track-plays-num">{{ plays }}</div>
              </div>
              <div class="track-like-container">
                <button class="like-btn-track album-like-size" data-track-id="{{ id }}">{{> likeBtn }}</button>
              </div>
              <div class="track-duration">{{ duration }}</div>
            </div>
          </div>
          {{/each}}
        </div>
      </div>
    </div>
    <div class="turquoise-oval"></div>
    <div class="overlay" id="albumDescriptionOverlay">
      <div class="window">
        <div class="overlay-header">
          <span class="album-title">{{ title }}</span>
          <button id="closeDescriptionButton" class="close-button" aria-label="Закрыть">{{> close }}</button>
        </div>
        <div class="header-divider"></div>
        <div class="card-sub all-description">{{ description }}</div>
      </div>
    </div>
  </div>
</div>
