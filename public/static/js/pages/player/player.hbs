<div class="player" id="player">
  <div class="player-left">
    <img src="" alt="Cover" class="track-cover-player" />
    <div class="track-info">
      <div class="track-title"></div>
      <div class="track-artist"></div>
    </div>
    {{> likeBtn }}
  </div>

  <div class="player-center">
    <div class="controls">
      <button class="control-btn shuffle">{{> shuffle}}</button>
      <button class="control-btn prev">{{> nextTrack}}</button>
      <button class="control-btn play">{{> playBtn }}</button>
      <button class="control-btn pause">{{> pauseBtn }}</button>
      <button class="control-btn next">{{> nextTrack }}</button>
      <button class="control-btn repeat">{{> repeat}}</button>
    </div>
    <div class="progress-remote">
      <span class="track-time current">0:42</span>
      <div class="remote-container">
        <input type="range" min="0" max="100" value="0" class="remote-slider" />
      </div>
      <span class="track-time total">2:42</span>
    </div>
  </div>

  <!-- Правая часть -->
  <div class="player-right">
    {{> volumeBar }}
    <input type="range" min="0" max="100" value="50" class="volume-slider" />
  </div>
</div>
