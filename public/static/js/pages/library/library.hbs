<div class="section" id="section">
  {{> header}}
  <div class="layout">
    {{> sidebar}}
    <div class="page" id="scrollContent">
      <div class="library-header">
        <div class="left-content">
          <div class="title-name">Библиотека</div>
          <div class="sort-buttons">
            <button class="secondary-button second-cross-icon" id="disableSort">{{> plus}}</button>
            <button class="secondary-button" data-name="playlists">Плейлисты</button>
            {{#if artists}}
            <button class="secondary-button" data-name="artists">Артисты</button>
            {{/if}}
            {{#if albums}}
            <button class="secondary-button" data-name="albums">Альбомы</button>
            {{/if}}
            {{#if tracks}}
            <button class="secondary-button">Треки</button>
            {{/if}}
          </div>
        </div>
        <div class="right-content">
          <button class="primary-button edit-button-size" id="createPlaylistButton">
            {{> plus}}
            Создать плейлист
          </button>
          <div class="library-search-container">
            <div class="search-icon">{{> searchIcon }}</div>
            <input type="text" class="search-input" id="searchInput" placeholder="Искать в библиотеке" />
          </div>
        </div>
      </div>
      <div class="grid-layout">
        {{> libraryGrid}}
      </div>
    </div>
    <div class="overlay" id="createPlaylistOverlay">
      <div class="window">
        <div class="overlay-header">
          <h2 class="title-name">Создать плейлист</h2>
          <button id="closeOverlayButton" class="close-button" aria-label="Закрыть">{{> close }}</button>
        </div>
        <div class="header-divider"></div>
        <div class="edit-profile-wrapper">
          <div class="edit-profile-info">
            <div class="edit-avatar">
              <div class="edit-avatar-placement">
                <img
                  src="static/img/default-playlist.png"
                  alt="Аватар плейлиста"
                  class="profile-image"
                  id="playlistAvatar"
                />
              </div>
              <div class="edit-avatar-buttons" id="editAvatarButtons">
                <button id="setAvatarButton" class="secondary-button save-avatar-button-size">Выбрать фото</button>
              </div>
            </div>
            <form id="createPlaylistForm">
              <div class="form-group">
                <label for="title">Название</label>
                <div class="input-wrapper">
                  <input type="text" id="title" name="title" placeholder="Добавь название" />
                  <div class="error-message" id="titleError"></div>
                  <div class="validation-message" id="titleInformation"></div>
                </div>
              </div>

              <div class="form-group">
                <label for="description">Описание</label>
                <div class="input-wrapper">
                  <textarea
                    maxlength="300"
                    id="description"
                    name="description"
                    placeholder="Добавь описание (необязательно)"
                  ></textarea>
                  <div class="validation-message" id="descriptionInformation"></div>
                </div>
              </div>

              <div class="general-error" id="generalError"></div>
            </form>
          </div>
          <div class="save-overlay-button">
            <button class="primary-button save-overlay-button-size" id="savePlaylistButton">Создать</button>
          </div>
        </div>
      </div>
    </div>
    <div class="context-menu playlist" id="contextMenu">
      <div class="context-container">
        <button data-action="move">{{> shuffle}}Перемешать</button>
        <button data-action="delete">{{> trash}}Удалить плейлист</button>
        <button data-action="pin">{{> pin}}Закрепить в библиотеке</button>
      </div>
    </div>

    <div class="context-menu artist" id="contextMenu">
      <div class="context-container">
        <button data-action="unfollow">{{> close}}Отписаться от исполнителя</button>
        <button data-action="pin">{{> pin}}Закрепить в библиотеке</button>
      </div>
    </div>
  </div>
</div>
