<link rel="stylesheet" href="static/css/import.css">
 
    <div class="support-header">
      <button id="backSupportBtn" class="support-back-btn">
        <svg viewBox="0 0 24 24" width="24" height="24"><path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"></path></svg>
        Назад
      </button>
    </div>

    <div class="support-content">
      <h2 class="support-title">Ваше обращение</h2>
      
      <form id="supportRequestForm" class="support-form">
        
        <div class="support-form-group">
          <label for="support-subject">С чем связана ваша проблема</label>
          <input type="text" id="support-subject" name="subject" placeholder="название проблема" value="Не работает музыку" required>
        </div>
        
        <div class="support-form-group">
          <label for="support-description">Опишите вашу проблему как можно подробнее</label>
          <textarea id="support-description" name="description" rows="6" placeholder="описание проблемы" value="описание проблемы" required></textarea>
        </div>

        

      </form>
    </div>
    <button type="submit" class="support-submit-btn">Изменить обращение</button>
    <button class="support-close-uplication-btn">Закрыть обращение</button>
    <script type="module" src="app.js"></script>
