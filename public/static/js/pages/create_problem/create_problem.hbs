<link rel="stylesheet" href="static/css/import.css">
 
    <div class="support-header">
      <button id="backSupportBtn" class="support-back-btn">
        <svg viewBox="0 0 24 24" width="24" height="24"><path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"></path></svg>
        Назад
      </button>
    </div>

    <div class="support-content">
      <h2 class="support-title">Расскажите о вашей проблеме</h2>
      
      <form id="supportRequestForm" class="support-form">
        
        <div class="support-form-group">
          <label for="support-subject">С чем связана ваша проблема</label>
          <input type="text" id="support-subject" name="subject" required>
        </div>
        
        <div class="support-form-group">
          <label for="support-description">Опишите вашу проблему как можно подробнее</label>
          <textarea id="support-description" name="description" rows="6" required></textarea>
        </div>

        <div class="support-form-group">
          <label for="support-type">Выберите тип проблемы</label>
          <div class="support-select-wrapper">
            <select id="support-type" name="type">
              <option value="Баг">Баг</option>
              <option value="Предложение">Предложение</option>
              <option value="Жалоба">Жалоба</option>
            </select>
          </div>
        </div>


      </form>

    </div>
    <button type="submit" class="support-submit-btn" id="specialButton">Создать обращение</button>

