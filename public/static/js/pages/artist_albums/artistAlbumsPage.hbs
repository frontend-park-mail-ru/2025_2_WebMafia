<div class="section" id="section">
  {{> header}}
  <div class="layout">
    {{> sidebar}}
    <div class="page" id="scrollContent">
      <div class="title">
        <div class="title-name">Альбомы исполнителя {{ artistName }}</div>
      </div>
      <div class="grid-layout">
        {{#each albums}}
        <div class="card">
          <a href="/album/{{ id }}">
            <img src="/{{ image }}" alt="{{ name }}" />
            <p class="card-name">{{ name }}</p>
            <p class="card-sub">{{ year }}</p>
          </a>
          <button class="play-button play-button-placement"></button>
        </div>
        {{/each}}
      </div>
    </div>
  </div>
  {{> player}}
</div>