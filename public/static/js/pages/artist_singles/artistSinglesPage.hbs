<div class="section" id="section">
  {{> header}}
  <div class="layout">
    {{> sidebar}}
    <div class="page" id="scrollContent">
      <div class="title">
        <div class="title-name-track-by-artist">Синглы и EP {{ artistName }}</div>
      </div>
      <div class="grid-layout">
        {{#each singles}}
        <div class="card">
          <a href="/album/{{ id }}">
            <img src="{{ cover }}" alt="{{ name }}" />
            <div class="card-bottom-info">
              <p class="card-name">{{ name }}</p>
              <p class="card-sub">
                {{ type }}
                <span class="dot"></span>
                {{ year }}
              </p>
            </div>
          </a>
          <!--<button class="play-button play-button-placement"></button>-->
        </div>
        {{/each}}
      </div>
    </div>
  </div>
</div>