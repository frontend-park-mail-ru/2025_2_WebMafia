<header class="head" id="header">
  <div class="head-left">
    <a href="/" class="logo">
      <span><img src="static/img/логотип.png" class="wave-icon" /></span>
      <h1 class="icon-name">Wave</h1>
    </a>
  </div>
  <div class="head-right">
    {{#if isAuthenticated}}
    <div class="profile-dropdown">
      <div class="header-username">{{ nickname }}</div>
      <button class="profile-btn">
        <div class="profile-avatar-header">
          {{#if avatar}}
          <img src="{{ avatar }}" alt="Ваш аватар" class="profile-avatar-header__image" />
          {{else}}
          <div class="default-avatar default-avatar-header">{{ letter }}</div>
          {{/if}}
        </div>
      </button>
      <div class="dropdown-menu">
        <a class="dropdown-hrefs" href="/profile">Профиль</a>
        <a class="dropdown-hrefs" href="/settings">Настройки</a>
        <a class="dropdown-hrefs" id="logoutBtn" href="#">Выйти</a>
      </div>
    </div>
    {{else}}
    <a class="nav-link login" href="/login">Войти</a>
    <a class="nav-link register" href="/register">Зарегистрироваться</a>
    {{/if}}
  </div>
</header>
