<div class="section" id="section">
  {{> header}}
  <div class="layout">
    {{> sidebar}}
    <div class="profile-wrapper" id="scrollContent">
      <div class="profile-container">
        <div class="blue-background-circle profile-blue-position"></div>
        <div class="purple-background-circle profile-purple-position"></div>
        <div class="profile-avatar user-avatar" id="avatarProfileContainer">
          {{#if profile.avatar}}
          <img src="{{ profile.avatar }}" alt="Ваш аватар" class="profile-image" />
          {{else}}
          <div class="default-avatar default-avatar-profile">{{ profile.letter }}</div>
          {{/if}}
        </div>
        <div class="profile-info">
          <div class="profile-username">{{ profile.nickname }}</div>
          <button class="primary-button edit-button-size" id="editProfileBtn">
            Редактировать
            {{> pencil }}
          </button>
        </div>
      </div>
      <div class="profile-page">
        <div class="title">
          <div class="title-name">Топ исполнителей этого месяца</div>
        </div>
        <div class="slider">
          <p><i class="slide-btn left"></i></p>
          <div class="cards" id="slidebar">
            {{#each top_artists}}
            <div class="card">
              <a href="/artist/{{ id }}">
                <img src="{{ image }}" alt="{{ name }}" />
                <p class="card-name">{{ name }}</p>
                <p class="card-sub">{{ listeners }} слушателей</p>
              </a>
              <!--<button class="play-button play-button-placement"></button>-->
            </div>
            {{/each}}
          </div>
          <p><i class="slide-btn right"></i></p>
        </div>

        <div class="title">
          <div class="title-name">Топ треков этого месяца</div>
        </div>
        <div class="tracks-table tracks-table-placement">
          {{#each top_tracks}}
            <div class="track-row">
              <div class="track-number">{{numeration @index}}</div>
              <div class="track-cover-wrapper">
                <img class="track-cover" src="{{ cover }}" alt="{{ name }}" />
                <button class="play-popular-track">{{> play }}</button>
              </div>
              <div class="right-row-content">
                <div class="track-name">{{ name }}</div>
                <div class="track-performers">
                  {{#each artists}}
                    <a href="artist/{{id}}" class="track-performer">
                      {{name}}{{#unless @last}}, {{/unless}}
                    </a>
                  {{/each}}
                </div>
                <div class="track-plays-num">{{ plays }} прослушиваний</div>
                <a href="album/{{ album_id }}" class="track-album-name">
                  {{ album }}
                </a>
                <div class="track-duration">{{ duration }}</div>
              </div>
            </div>
          {{/each}}
        </div>

        <div class="title">
          <div class="title-name">Недавно прослушано</div>
        </div>
        <div class="slider">
          <p><i class="slide-btn left"></i></p>
          <div class="cards" id="slidebar">
            {{#each recent}}
            <div class="card">
              <a href="/artist/{{ id }}">
                <img src="{{ image }}" alt="{{ name }}" />
                <p class="card-name">{{ name }}</p>
                <p class="card-sub">{{ listeners }} слушателей</p>
              </a>
              <!--<button class="play-button play-button-placement"></button>-->
            </div>
            {{/each}}
          </div>
          <p><i class="slide-btn right"></i></p>
        </div>
      </div>
    </div>
    <div class="edit-profile-overlay" id="editProfileOverlay">
      <div class="edit-profile-window">
        <h2 class="title-name">Редактировать профиль</h2>
        <div class="edit-profile-wrapper">
          <div class="edit-profile-info">
            <div class="edit-avatar">
              <div class="edit-avatar-placement user-avatar" id="avatarEditContainer">
                {{#if profile.avatar}}
                <img src="{{ profile.avatar }}" alt="Ваш аватар" class="profile-image" />
                {{else}}
                <div class="default-avatar profile-edit-avatar">{{ profile.letter }}</div>
                {{/if}}
              </div>
              <div class="edit-avatar-buttons" id="editAvatarButtons">
                <button id="setAvatarButton" class="secondary-button save-avatar-button-size">Выбрать фото</button>
                {{#if profile.avatar}}
                <button id="deleteAvatarButton" class="secondary-button save-avatar-button-size">Удалить фото</button>
                {{/if}}
              </div>
            </div>
            <form id="editProfileForm">
              <div class="form-group">
                <label for="email">Адрес почты</label>
                <div class="input-wrapper">
                  <input type="email" id="email" name="email" placeholder="example@domain.com" value="{{ profile.email }}" />
                  <div class="error-message" id="emailError"></div>
                  <div class="validation-message" id="emailInformation"></div>
                </div>
              </div>

              <div class="form-group">
                <label for="login">Имя пользователя</label>
                <div class="input-wrapper">
                  <input type="text" id="login" name="login" placeholder="Имя пользователя" value="{{ profile.nickname }}" />
                  <div class="error-message" id="loginError"></div>
                  <div class="validation-message" id="loginInformation"></div>
                </div>
              </div>

              <div class="form-group">
                <label for="password">Сменить пароль</label>
                <div class="password-wrapper">
                  <input type="password" id="password" name="password" placeholder="Пароль" />
                  <button type="button" class="eye" aria-label="Показать пароль">
                    {{> eyeOpen }}
                    {{> eyeClosed }}
                  </button>
                  <div class="validation-message" id="passwordInformation"></div>
                  <div class="error-message" id="passwordError"></div>
                </div>
              </div>

              <div class="form-group">
                <div class="password-wrapper">
                  <input type="password" id="passwordConfirm" name="passwordConfirm" placeholder="Повторите пароль" />
                  <button type="button" class="eye" aria-label="Показать пароль">
                    {{> eyeOpen }}
                    {{> eyeClosed }}
                  </button>
                  <div class="validation-message" id="passwordConfirmInformation"></div>
                  <div class="error-message" id="passwordConfirmError"></div>
                </div>
              </div>

              <div class="general-error" id="generalError"></div>
            </form>
          </div>
          <div class="edit-profile-buttons">
            <button id="closeEditButton" class="secondary-button">Закрыть</button>
            <button class="primary-button save-profile-button-size" id="saveProfileChangesButton">Сохранить изменения</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
