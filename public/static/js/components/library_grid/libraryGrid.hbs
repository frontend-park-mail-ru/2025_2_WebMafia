{{#each library}}
<a class="card" href="/{{ href }}" data-type="{{ type }}" data-id="{{ id }}">
  <div id="playlistCover"><img src="{{ image }}" alt="{{ name }}" /></div>
  
  <div class="card-bottom-info">
    <p class="card-name">{{ name }}</p>
    <p class="card-sub card-sub-limiter">
      {{#if ../showType}}
      {{ type }}
      <span class="dot"></span>
      {{/if}}
      <span class="text">{{ sub }}</span>
    </p>
  </div>
  <!--<button class="play-button play-button-placement"></button>-->
</a>
{{/each}}
