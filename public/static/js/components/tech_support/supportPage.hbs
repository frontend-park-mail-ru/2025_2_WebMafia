<link rel="stylesheet" href="/static/css/import.css">
<div class="support-header">
  <h2 class="support-title">Техническая поддержка</h2>
  <button id="closeSupportButton" class="close-button" aria-label="Закрыть">{{> close }}</button>
</div>
<div class="support-content">
  <h3 class="waiting-title">Ожидают вашего ответа</h3>
  <div class="support-cards">
    {{#each open_tickets}}
    <div class="support-card" id="supportCards" data-ticket-id="{{ id }}">
      <div class="support-card-title">{{ name }}</div>
      <div class="support-card-date">Обновлено: {{ date }}</div>
    </div>
    {{/each}}
  </div>
  <h3 class="closed-title">Решены</h3>
  <div class="support-cards">
    {{#each open_tickets}}
    <div class="support-card" id="supportCards" data-ticket-id="{{ id }}">
      <div class="support-card-title">{{ name }}</div>
      <div class="support-card-date">Закрыто: {{ date }}</div>
    </div>
    {{/each}}
  </div>
</div>
<div class="primary-button support-button-placement" id="createTicket">Создать обращение</div>
<script type="module" src="app.js"></script>