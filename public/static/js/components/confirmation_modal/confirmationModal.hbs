<div class="overlay" id="confirmationModalOverlay">
  <div class="window">
    <div class="overlay-header">
      <span class="warning-title">{{ title }}</span>
    </div>

    <div class="warning-sub">
      {{{ description }}}
    </div>

    <div class="warning-btns-overlay">
      <div class="save-overlay-button">
        <button class="secondary-button save-overlay-button-size modal-cancel-btn">
          {{{ cancelText }}}
        </button>
      </div>

      <div class="save-overlay-button">
        <button class="primary-button save-overlay-button-size modal-confirm-btn">
          {{{ confirmText }}}
        </button>
      </div>
    </div>
  </div>
</div>
