<div class="overlay" id="warningOverlaySidebar">
  <div class="window">
    <div class="overlay-header">
      <span class="album-title">Чтобы создавать плейлисты вам нужно войти в аккаунт</span>
      <button id="closeWarningBtnSidebar" class="close-button" aria-label="Закрыть">{{> close }}</button>
    </div>
    <div class="header-divider"></div>
    <div class="warning-btns-overlay">
      <div class="save-overlay-button">
      <button class="primary-button login secondary-button save-overlay-button-size" id="loginBtnSidebar">
        Войти
      </button>
    </div>
    <div class="save-overlay-button">
      <button class="primary-button register save-overlay-button-size" id="registerBtnSidebar">
        Зарегистрироваться
      </button>
    </div>
    </div>
    
  </div>
</div>

<div class="purple-background-circle sidebar-purple-position"></div>
<div class="blue-background-circle sidebar-blue-position"></div>
    <div class="overlay" id="createPlaylistOverlay">
      <div class="window">
        <div class="overlay-header">
          <h2 class="title-name">Создать плейлист</h2>
          <button id="closeOverlayButtonCreatePlaylist" class="close-button" aria-label="Закрыть">{{> close }}</button>
        </div>
        <div class="header-divider"></div>
        <div class="edit-profile-wrapper">
          <div class="edit-profile-info">
            <div class="edit-avatar">
              <div class="edit-avatar-placement">
                <img
                  src=""
                  alt="Аватар плейлиста"
                  class="profile-image"
                  id="playlistAvatar"
                />
              </div>
              <div class="edit-avatar-buttons" id="editAvatarButtonsPlaylist">
                <button id="setAvatarButtonPlaylist" class="secondary-button save-avatar-button-size">Выбрать фото</button>
              </div>
            </div>
            <form id="createPlaylistForm">
              <div class="form-group">
                <label for="title">Название</label>
                <div class="input-wrapper">
                  <input type="text" id="title" name="title" placeholder="Добавь название" />
                  <div class="error-message" id="titleError"></div>
                  <div class="validation-message" id="titleInformation"></div>
                </div>
              </div>

              <div class="form-group">
                <label for="description">Описание</label>
                <div class="input-wrapper">
                  <textarea
                    maxlength="300"
                    id="description"
                    name="description"
                    placeholder="Добавь описание (необязательно)"
                  ></textarea>
                  <div class="validation-message" id="descriptionInformation"></div>
                </div>
              </div>

              <div class="general-error" id="generalError"></div>
            </form>
          </div>
          <div class="save-overlay-button">
            <button class="primary-button save-overlay-button-size" id="savePlaylistButton">Создать</button>
          </div>
        </div>
      </div>
    </div>
